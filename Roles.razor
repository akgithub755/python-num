@page "/customers"
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using OnDemandLaunchApp.Models
@using OnDemandLaunchApp.Services
@inject ToastService Toasts
@* If _Imports.razor already injects these, delete the duplicate lines below *@
@inject HttpClient Http
@inject IJSRuntime JS
@namespace OnDemandLaunchApp.Pages.Table_Management

<div class="space-y-6">

    <div class="border p-4 rounded shadow flex gap-4">

        <!-- Left: Tables list -->
        <div class="w-64 border rounded shadow-sm shrink-0">
            <div class="p-2 border-b font-medium text-sm bg-gray-50">Tables</div>
            <ul class="divide-y text-sm">
                @foreach (var table in tableNames)
                {
                    <li>
                        <button class="w-full text-left px-3 py-2 hover:bg-gray-100 @(table == selectedTable ? "bg-teal-50 font-medium" : "")"
                                @onclick="() => SelectTable(table)">
                            @table
                        </button>
                    </li>
                }
            </ul>
        </div>

        <!-- Right: Data grid -->
        <div class="flex-1 border rounded shadow-sm overflow-hidden flex flex-col">

            @if (isLoading)
            {
                <div class="p-4 text-sm">Loading @selectedTable...</div>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="p-4 text-sm alert">@errorMessage</div>
            }
            else
            {
                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-sm border-collapse">
                        <thead>
                            <tr class="bg-gray-50 border-b">
                                @foreach (var column in columns)
                                {
                                    <th class="text-left px-3 py-2 font-medium border-r last:border-r-0">
                                        @column.Name@(column.IsKey ? " (PK)" : "")
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr class="border-b hover:bg-gray-50 @GetRowClass(row)"
                                    @onclick="() => SelectRow(row)">
                                    @foreach (var column in columns)
                                    {
                                        <td class="px-3 py-2 border-r last:border-r-0">
                                            @if (CanEdit(row, column) &&
                                                 ReferenceEquals(editingRow, row) &&
                                                 editingColumn == column.Name)
                                            {
                                                <input class="w-full border px-1"
                                                       @bind="row.Values[column.Name]"
                                                       @bind:event="oninput"
                                                       @bind:after="() => row.Dirty = true"
                                                       @onblur="EndEdit"
                                                       @onclick:stopPropagation="true" />
                                            }
                                            else
                                            {
                                                <div class="h-6 @(CanEdit(row, column) ? "cursor-text" : "text-gray-500")"
                                                     @onclick="() => BeginEdit(row, column)">
                                                    @DisplayValue(row.Values[column.Name])
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                            @if (rows.Count == 0)
                            {
                                <tr>
                                    <td class="px-3 py-3 text-gray-400" colspan="@Math.Max(columns.Count, 1)">
                                        No data found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Action buttons -->
            <div class="flex gap-2 justify-start items-center p-3 border-t bg-gray-50">
                <button class="btn-primary text-sm px-3 py-2" @onclick="ExportTable" disabled="@(isLoading || isSaving)">Export</button>
                <button class="btn-primary text-sm px-3 py-2" @onclick="RefreshTable" disabled="@(isLoading || isSaving)">Refresh</button>
                <button class="btn-primary text-sm px-3 py-2" @onclick="AddRow" disabled="@(isLoading || isSaving || selectedTable is null)">Add row</button>
                <button class="btn-primary text-sm px-3 py-2" @onclick="SaveTable" disabled="@(isLoading || isSaving || selectedTable is null)">@(isSaving ? "Saving..." : "Save")</button>
                <button class="btn-primary text-sm px-3 py-2" @onclick="DeleteRow" disabled="@(isLoading || isSaving || selectedRow is null)">Delete</button>

                <span class="text-xs text-gray-500 ml-2">
                    @rows.Count row(s)@(PendingCount > 0 ? $" - {PendingCount} unsaved change(s)" : "")
                </span>
            </div>
        </div>

    </div>
</div>

@code {
    private const string Api = "/api/TableManagement";

    public class ColumnInfo
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "";
        public bool IsKey { get; set; }
    }

    public class TableData
    {
        public List<ColumnInfo> Columns { get; set; } = new();
        public List<List<JsonElement>> Rows { get; set; } = new();
    }

    public class GridRow
    {
        public Dictionary<string, string?> Values { get; set; } = new();
        public bool IsNew { get; set; }
        public bool Dirty { get; set; }
    }

    private List<string> tableNames = new();
    private string? selectedTable;
    private List<ColumnInfo> columns = new();
    private List<GridRow> rows = new();

    private GridRow? selectedRow;
    private GridRow? editingRow;
    private string? editingColumn;

    private bool isLoading;
    private bool isSaving;
    private string? errorMessage;

    private bool HasKey => columns.Any(c => c.IsKey);
    private int PendingCount => rows.Count(r => r.IsNew || r.Dirty);

    // ---------- Init ----------

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tableNames = await Http.GetFromJsonAsync<List<string>>($"{Api}/tables") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load table list: {ex.Message}";
            return;
        }

        selectedTable = tableNames.Contains("roles") ? "roles" : tableNames.FirstOrDefault();

        if (selectedTable is not null)
            await LoadTableData(selectedTable);
    }

    // ---------- Selection / editing ----------

    private async Task SelectTable(string table)
    {
        if (table == selectedTable || isLoading || isSaving)
            return;

        if (PendingCount > 0 &&
            !await JS.InvokeAsync<bool>("confirm", "Discard unsaved changes?"))
            return;

        selectedTable = table;
        await LoadTableData(table);
    }

    private void SelectRow(GridRow row)
    {
        selectedRow = row;
    }

    private bool CanEdit(GridRow row, ColumnInfo column) =>
        row.IsNew || (HasKey && !column.IsKey);

    private void BeginEdit(GridRow row, ColumnInfo column)
    {
        selectedRow = row;

        if (!CanEdit(row, column))
            return;

        editingRow = row;
        editingColumn = column.Name;
    }

    private void EndEdit()
    {
        editingRow = null;
        editingColumn = null;
    }

    private string GetRowClass(GridRow row)
    {
        if (row == selectedRow) return "bg-blue-100";
        if (row.IsNew) return "bg-green-50";
        if (row.Dirty) return "bg-yellow-50";
        return string.Empty;
    }

    private static string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "--" : value;

    // ---------- Load / Refresh ----------

    private async Task LoadTableData(string table)
    {
        isLoading = true;
        errorMessage = null;

        selectedRow = null;
        EndEdit();

        try
        {
            var data = await Http.GetFromJsonAsync<TableData>(
                $"{Api}/{Uri.EscapeDataString(table)}");

            columns = data?.Columns ?? new();

            rows = (data?.Rows ?? new()).Select(r =>
            {
                var row = new GridRow();
                for (var i = 0; i < columns.Count; i++)
                    row.Values[columns[i].Name] = i < r.Count ? ToText(r[i]) : null;
                return row;
            }).ToList();
        }
        catch (HttpRequestException ex)
        {
            columns = new();
            rows = new();
            errorMessage = $"Unable to load table '{table}': {ex.Message}";
        }
        catch (Exception ex)
        {
            columns = new();
            rows = new();
            errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string? ToText(JsonElement e) => e.ValueKind switch
    {
        JsonValueKind.Null or JsonValueKind.Undefined => null,
        JsonValueKind.String => e.GetString(),
        _ => e.GetRawText()
    };

    private async Task RefreshTable()
    {
        if (selectedTable is null)
            return;

        if (PendingCount > 0 &&
            !await JS.InvokeAsync<bool>("confirm", "Discard unsaved changes?"))
            return;

        await LoadTableData(selectedTable);

        if (errorMessage is null)
            Toasts.Success("Table refreshed successfully.");
    }

    // ---------- Add / Save / Delete ----------

    private void AddRow()
    {
        var row = new GridRow { IsNew = true, Dirty = true };

        foreach (var c in columns)
            row.Values[c.Name] = null;

        rows.Insert(0, row);
        selectedRow = row;

        var first = columns.FirstOrDefault();
        if (first is not null)
            BeginEdit(row, first);
    }

    private static Dictionary<string, string?> Normalize(Dictionary<string, string?> values) =>
        values.ToDictionary(
            kv => kv.Key,
            kv => string.IsNullOrWhiteSpace(kv.Value) ? null : kv.Value);

    private async Task SaveTable()
    {
        if (selectedTable is null || isSaving)
            return;

        var inserts = rows.Where(r => r.IsNew).Select(r => Normalize(r.Values)).ToList();
        var updates = rows.Where(r => !r.IsNew && r.Dirty).Select(r => Normalize(r.Values)).ToList();

        if (inserts.Count + updates.Count == 0)
        {
            Toasts.Warning("Please make changes before saving.");
            return;
        }

        isSaving = true;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"{Api}/{Uri.EscapeDataString(selectedTable)}/save",
                new { inserts, updates });

            if (response.IsSuccessStatusCode)
            {
                Toasts.Success("Save successful");
                await LoadTableData(selectedTable);
            }
            else
            {
                await ShowHttpError(response, "Unable to save data.");
            }
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error($"Unable to save table: {ex.Message}");
        }
        catch (Exception ex)
        {
            Toasts.Error($"An unexpected error occurred: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteRow()
    {
        if (selectedTable is null || selectedRow is null || isSaving)
            return;

        // Unsaved new row: just drop it locally
        if (selectedRow.IsNew)
        {
            rows.Remove(selectedRow);
            selectedRow = null;
            EndEdit();
            return;
        }

        var keyColumns = columns.Where(c => c.IsKey).ToList();

        if (keyColumns.Count == 0)
        {
            Toasts.Warning("This table has no primary key, rows cannot be deleted.");
            return;
        }

        if (!await JS.InvokeAsync<bool>("confirm", "Delete the selected row?"))
            return;

        isSaving = true;

        try
        {
            var key = keyColumns.ToDictionary(c => c.Name, c => selectedRow.Values[c.Name]);

            using var response = await Http.PostAsJsonAsync(
                $"{Api}/{Uri.EscapeDataString(selectedTable)}/delete", key);

            if (response.IsSuccessStatusCode)
            {
                Toasts.Success("Row deleted");
                await LoadTableData(selectedTable);
            }
            else
            {
                await ShowHttpError(response, "Unable to delete data.");
            }
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error($"Unable to delete row: {ex.Message}");
        }
        catch (Exception ex)
        {
            Toasts.Error($"An unexpected error occurred: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    // ---------- Export ----------

    private async Task ExportTable()
    {
        if (selectedTable is null || columns.Count == 0)
            return;

        var sb = new StringBuilder("\uFEFF");
        sb.AppendLine(string.Join(",", columns.Select(c => Csv(c.Name))));

        foreach (var row in rows)
            sb.AppendLine(string.Join(",", columns.Select(c => Csv(row.Values[c.Name]))));

        await JS.InvokeVoidAsync("tableHelpers.downloadFile", $"{selectedTable}.csv", sb.ToString());
    }

    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        return value.IndexOfAny(new[] { ',', '"', '\n', '\r' }) >= 0
            ? "\"" + value.Replace("\"", "\"\"") + "\""
            : value;
    }

    // ---------- Shared ----------

    private async Task ShowHttpError(HttpResponseMessage response, string fallback)
    {
        var body = await response.Content.ReadAsStringAsync();
        var message = body;

        try
        {
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var m) ||
                doc.RootElement.TryGetProperty("Message", out m))
                message = m.GetString() ?? body;
        }
        catch (JsonException)
        {
            // body was not JSON, show it as-is
        }

        Toasts.Error(
            string.IsNullOrWhiteSpace(message)
                ? $"{fallback} HTTP {(int)response.StatusCode}"
                : message);
    }
}
